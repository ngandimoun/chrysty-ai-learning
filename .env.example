# Chrysty platform
CHRYSTY_API_URL=https://api.chrysty.dev
NEXT_PUBLIC_CHRYSTY_API_URL=https://api.chrysty.dev

MOONSHOT_API_KEY=sk-your-key-here
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Required on Vercel for session persistence (practice, learn, think)
NEXT_PUBLIC_SUPABASE_URL=https://uusnstujtczqjorfqgdn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

KIMI_MODEL_LEARN=kimi-k2.6
KIMI_MODEL_THINK=kimi-k2.6
KIMI_MODEL_PRACTICE=kimi-k2.6
KIMI_MODEL_PRACTICE_CODE=kimi-k2.7-code

# Optional — required for POST /api/admin/batch
ADMIN_SECRET=your-admin-secret

# Formula tools (comma-separated names or full URIs)
KIMI_FORMULAS_LEARN=web-search,fetch
KIMI_FORMULAS_THINK=web-search,rethink
KIMI_FORMULAS_PRACTICE=web-search,convert,memory
# Optional: code_runner (requires Moonshot formula access on your API key)
KIMI_FORMULAS_GENERATE=web-search
KIMI_MAX_TOOL_ROUNDS=5
# Note: web-search tokens count toward prompt_tokens; Formula tools may incur per-call fees.

# Mastra server URL (optional — defaults to http://localhost:4111)
MASTRA_API_URL=http://localhost:4111

# Gemini — composer voice transcription (POST /api/composer/transcribe)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_TRANSCRIBE=gemini-3.1-flash

# Build-time only (install @chrysty/platform from private monorepo)
# GITHUB_TOKEN=
